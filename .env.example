# Copy to .env (gitignored) and fill in values. Loaded automatically by the CLI
# if present in the current working directory. Never commit real values.

# --- Pipeline locations (all optional; defaults shown) ---------------------
# Where projects/<name>/project.yaml live.
#AIP_PROJECTS_ROOT=./projects
# Where generated state and artifacts live (datasets, runs, models, logs).
#AIP_ARTIFACT_ROOT=./artifacts
# Infrastructure file naming compute backends and deployment targets.
#AIP_INFRA_FILE=./infrastructure.yaml

# --- Values referenced from infrastructure.yaml / project.yaml via ${VAR} ---
# RTSP source for the demo deployment target (may embed camera credentials,
# which is why it lives here and not in YAML).
#NG4511_RTSP_URL=rtsp://user:password@camera.local:554/stream1

# --- Authentication ---------------------------------------------------------
# SSH to the NG4511 uses the operator's ~/.ssh/config and key agent only.
# No passwords are read from the environment.
